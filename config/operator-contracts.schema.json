{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PIDEX local operator contract overrides v2",
  "type": "object",
  "required": ["version", "overrides"],
  "properties": {
    "version": { "const": 2 },
    "overrides": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["timestamp", "id", "status", "operator_type", "contract_id", "reason", "contract_patch", "historical_reclassification"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "id": { "type": "string", "minLength": 1, "maxLength": 160 },
          "status": { "enum": ["pending", "approved", "rejected", "superseded"] },
          "operator_type": { "enum": ["OpPreflight", "OpQualityReview"] },
          "contract_id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
          "approved_by": { "type": "string", "minLength": 1, "maxLength": 120 },
          "approved_at": { "type": "string", "format": "date-time" },
          "effective_from": { "type": "string", "format": "date-time" },
          "source_decision_id": { "type": ["string", "null"], "maxLength": 160 },
          "historical_reclassification": { "const": "future-only" },
          "contract_patch": {
            "type": "object",
            "required": ["allowed_skip_reasons"],
            "properties": {
              "allowed_skip_reasons": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "uniqueItems": true,
                "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "approved" } } },
            "then": { "required": ["approved_by", "approved_at", "effective_from"] }
          },
          {
            "if": { "properties": { "operator_type": { "const": "OpPreflight" } } },
            "then": { "properties": { "contract_id": { "const": "operator.OpPreflight.finalized-preflight" } } }
          },
          {
            "if": { "properties": { "operator_type": { "const": "OpQualityReview" } } },
            "then": { "properties": { "contract_id": { "const": "operator.OpQualityReview.terminal-pdq" } } }
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
