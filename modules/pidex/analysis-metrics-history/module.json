{
  "id": "pidex.analysis-metrics-history",
  "schema_version": 1,
  "name": "PIDEX Analysis, Metrics, and History",
  "kind": "optional-internal",
  "default_enabled": true,
  "dependencies": [
    "pidex.core"
  ],
  "capabilities": [
    {
      "id": "analysis-metrics-history.record-event",
      "kind": "tool",
      "phases": [
        "planning",
        "implementation",
        "code-review",
        "qa",
        "uat",
        "devops",
        "maintenance"
      ],
      "scope": "project",
      "importance": "optional",
      "allowed_agents": [
        "orchestrator",
        "pidex-planner",
        "pidex-implementer",
        "pidex-code-reviewer",
        "pidex-qa",
        "pidex-uat",
        "pidex-devops",
        "pidex-pi"
      ],
      "supported_platforms": [
        "linux",
        "wsl2",
        "windows-git-bash",
        "windows-native"
      ],
      "mutability": [
        "writes-artifacts"
      ],
      "command": {
        "bin": "node",
        "args": [
          "modules/pidex/analysis-metrics-history/scripts/pipeline/event.mjs"
        ],
        "passthrough": true,
        "passthrough_policy": {
          "allowed_patterns": [
            "^--(project|state-dir|project-slug|slug|pipeline-id|plan|event|event-type|status|actor|message|source|project-mode|test-project|metadata-json)$"
          ],
          "allowed_value_patterns": {
            "--project": ["^[A-Za-z0-9 ._:/=@\\\\-]+$"],
            "--state-dir": ["^[A-Za-z0-9 ._:/=@\\\\-]+$"],
            "--project-slug": ["^[A-Za-z0-9._-]{1,160}$"],
            "--slug": ["^[A-Za-z0-9._-]{1,160}$"],
            "--pipeline-id": ["^[A-Za-z0-9._-]{1,160}$"],
            "--plan": ["^[A-Za-z0-9._-]{1,80}$"],
            "--event": ["^[a-z][a-z_]{0,63}$"],
            "--event-type": ["^[a-z][a-z_]{0,63}$"],
            "--status": ["^[A-Za-z0-9._-]{1,80}$"],
            "--actor": ["^[A-Za-z0-9._-]{1,80}$"],
            "--message": ["^[\\s\\S]{1,2000}$"],
            "--source": ["^[A-Za-z0-9._-]{1,80}$"],
            "--project-mode": ["^(host-direct|hardened-pipeline|project-pipeline)$"],
            "--test-project": ["^(true|false)$"],
            "--metadata-json": ["^\\{[\\s\\S]{0,16000}\\}$"]
          },
          "allow_absolute_project_paths": true
        }
      }
    },
    {
      "id": "analysis-metrics-history.history-append",
      "kind": "tool",
      "phases": [
        "planning",
        "implementation",
        "code-review",
        "qa",
        "uat",
        "devops",
        "maintenance"
      ],
      "scope": "project",
      "importance": "optional",
      "allowed_agents": [
        "orchestrator",
        "pidex-planner",
        "pidex-implementer",
        "pidex-code-reviewer",
        "pidex-qa",
        "pidex-uat",
        "pidex-devops",
        "pidex-pi"
      ],
      "supported_platforms": [
        "linux",
        "wsl2",
        "windows-git-bash"
      ],
      "mutability": [
        "writes-artifacts"
      ],
      "command": {
        "bin": "bash",
        "args": [
          "modules/pidex/analysis-metrics-history/scripts/history/append.sh"
        ],
        "passthrough": true,
        "passthrough_policy": {
          "allowed_patterns": [
            "^--[A-Za-z0-9-]+$",
            "^[A-Za-z0-9 ._:/=@+-]+$"
          ],
          "allow_absolute_project_paths": true
        }
      }
    },
    {
      "id": "analysis-metrics-history.history-list",
      "kind": "report",
      "phases": [
        "planning",
        "implementation",
        "code-review",
        "qa",
        "uat",
        "devops",
        "maintenance"
      ],
      "scope": "project",
      "importance": "optional",
      "allowed_agents": [
        "orchestrator",
        "pidex-planner",
        "pidex-implementer",
        "pidex-code-reviewer",
        "pidex-qa",
        "pidex-uat",
        "pidex-devops",
        "pidex-pi"
      ],
      "supported_platforms": [
        "linux",
        "wsl2",
        "windows-git-bash"
      ],
      "mutability": [
        "read-only"
      ],
      "command": {
        "bin": "bash",
        "args": [
          "modules/pidex/analysis-metrics-history/scripts/history/list.sh"
        ],
        "passthrough": true,
        "passthrough_policy": {
          "allowed_patterns": [
            "^--(limit|project|json)$",
            "^[A-Za-z0-9 ._:/=@-]+$"
          ],
          "allow_absolute_project_paths": true
        }
      }
    },
    {
      "id": "analysis-metrics-history.metrics-record",
      "kind": "tool",
      "phases": [
        "planning",
        "implementation",
        "code-review",
        "qa",
        "uat",
        "devops",
        "maintenance"
      ],
      "scope": "project",
      "importance": "optional",
      "allowed_agents": [
        "orchestrator",
        "pidex-planner",
        "pidex-implementer",
        "pidex-code-reviewer",
        "pidex-qa",
        "pidex-uat",
        "pidex-devops",
        "pidex-pi"
      ],
      "supported_platforms": [
        "linux",
        "wsl2",
        "windows-git-bash"
      ],
      "mutability": [
        "writes-artifacts"
      ],
      "command": {
        "bin": "bash",
        "args": [
          "modules/pidex/analysis-metrics-history/scripts/metrics/record.sh"
        ],
        "passthrough": true,
        "passthrough_policy": {
          "allowed_patterns": [
            "^--[A-Za-z0-9-]+$",
            "^[A-Za-z0-9 ._:/=@+-]+$"
          ],
          "allow_absolute_project_paths": true
        }
      }
    },
    {
      "id": "analysis-metrics-history.metrics-summarize",
      "kind": "report",
      "phases": [
        "planning",
        "implementation",
        "code-review",
        "qa",
        "uat",
        "devops",
        "maintenance"
      ],
      "scope": "project",
      "importance": "optional",
      "allowed_agents": [
        "orchestrator",
        "pidex-planner",
        "pidex-implementer",
        "pidex-code-reviewer",
        "pidex-qa",
        "pidex-uat",
        "pidex-devops",
        "pidex-pi"
      ],
      "supported_platforms": [
        "linux",
        "wsl2",
        "windows-git-bash"
      ],
      "mutability": [
        "read-only"
      ],
      "command": {
        "bin": "bash",
        "args": [
          "modules/pidex/analysis-metrics-history/scripts/metrics/summarize.sh"
        ],
        "passthrough": true,
        "passthrough_policy": {
          "allowed_patterns": [
            "^--[A-Za-z0-9-]+$",
            "^[A-Za-z0-9 ._:/=@+-]+$"
          ],
          "allow_absolute_project_paths": true
        }
      }
    }
  ]
}
